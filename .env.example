# Server
NODE_ENV=development
PORT=3000

# Database
DB_PATH=./data/app.db

# Authentication
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password

# CORS (comma-separated origins)
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# Demo Mode (optional - usually detected via subdomain)
# DEMO_MODE=false
# VITE_DEMO_MODE=false

# --- Capstone: AI/RAG/Agent ---

# Python RAG service URL
PYTHON_SERVICE_URL=http://localhost:8000

# API Keys (required for RAG/agent features starting Phase 3)
OPENAI_API_KEY=sk-your-openai-key
GROQ_API_KEY=gsk_your-groq-key
MINIMAX_API_KEY=your-minimax-key

# Models
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=llama-3.3-70b-versatile
AGENT_MODEL=MiniMax-M2

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RAG_TOP_K=5

# File uploads
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./data/uploads
FAISS_INDEX_DIR=./python-service/data/faiss
