{
  "name": "ai-engineering-practice-lab",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run dev:client\" \"bun run dev:server\"",
    "dev:client": "vite",
    "dev:server": "bun run --watch server/index.ts",
    "build": "tsc && vite build",
    "start": "NODE_ENV=production bun run server/index.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:unit": "bun test server/__tests__/unit src/__tests__/services",
    "test:integration": "bun test server/__tests__/integration",
    "test:components": "bun test src/__tests__/components",
    "test:edge": "bun test server/__tests__/edge-cases",
    "test:coverage": "bun test --coverage",
    "test:backend": "bun test server/__tests__",
    "test:frontend": "bun test src/__tests__",
    "db:seed": "bun run server/scripts/seed-lessons.ts",
    "db:seed-vocabulary": "bun run server/scripts/seed-vocabulary.ts"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.30.0",
    "@codemirror/lang-javascript": "^6.2.0",
    "@codemirror/lang-python": "^6.2.1",
    "@emotion/react": "^11.14.0",
    "@tanstack/react-query": "^5.0.0",
    "@uiw/react-codemirror": "^4.23.0",
    "date-fns": "^4.1.0",
    "diff": "^7.0.0",
    "framer-motion": "^12.0.0",
    "hono": "^4.10.0",
    "nanoid": "^5.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^7.0.0",
    "rehype-highlight": "^7.0.0",
    "supermemo": "^2.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.3.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/diff": "^6.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.0.0",
    "happy-dom": "^20.3.7",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
